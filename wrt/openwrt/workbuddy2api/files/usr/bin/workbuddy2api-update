#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""workbuddy2api 自动更新器（OpenWrt 版）

上游是纯 Python 标准库应用，所以更新不需要重新编译/重装 apk：把
/usr/lib/workbuddy2api 下的 wb_*.py + dashboard.html 换成新版即可。
本脚本做完整的安全闭环：

  查最新版（GitHub releases/latest）-> 下载源码 tarball -> 校验
  （文件齐全 / 版本号一致 / py_compile / 真导入一次）-> 停服务 -> 备份
  当前版本 -> 原子替换 -> 起服务 -> 健康检查 -> 失败自动回滚

用法：
  workbuddy2api-update              检查并更新（有新版本才动）
  workbuddy2api-update --check      只检查；有更新退出码 10，无更新 0
  workbuddy2api-update --force      无视版本比较，重装最新版
  workbuddy2api-update --rollback   回滚到上一版（不联网）
  workbuddy2api-update --quiet      cron 用：只把结果写 syslog，不打印

配置（uci workbuddy2api.main）：
  auto_update  0/1，默认 1；为 0 时本脚本直接退出（--force 除外）
  port         健康检查端口，默认 8788

测试用环境变量覆盖（沙箱验证用，正常部署不需要）：
  WB2API_APP_DIR / WB2API_PREV_DIR / WB2API_STATE_FILE / WB2API_LOCK_FILE
  WB2API_SERVICE / WB2API_HEALTH_URL / WB2API_SERVICE_PGREP

退出码：0 正常（已是最新/更新成功/已禁用）  10 有新版本（--check）
        1 出错（下载/校验/健康检查失败，失败时已尝试回滚）
"""

import argparse
import json
import os
import py_compile
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

APP_DIR = os.environ.get("WB2API_APP_DIR") or "/usr/lib/workbuddy2api"
PREV_DIR = os.environ.get("WB2API_PREV_DIR") or "/usr/lib/workbuddy2api.prev"
STATE_FILE = os.environ.get("WB2API_STATE_FILE") or "/etc/workbuddy2api/update-state.json"
LOCK_FILE = os.environ.get("WB2API_LOCK_FILE") or "/var/lock/workbuddy2api-update.lock"
SERVICE = os.environ.get("WB2API_SERVICE") or "/etc/init.d/workbuddy2api"
HEALTH_URL_OVERRIDE = os.environ.get("WB2API_HEALTH_URL") or ""
SERVICE_PGREP = os.environ.get("WB2API_SERVICE_PGREP") or "wb_proxy.py"

API_URL = "https://api.github.com/repos/ardeyouxipianyi/workbuddy2api-hub/releases/latest"
TARBALL_URL = "https://codeload.github.com/ardeyouxipianyi/workbuddy2api-hub/tar.gz/%s"
UA = {"User-Agent": "workbuddy2api-wrt-updater/1.0"}
REQUIRED = ("wb_proxy.py", "wb_accounts.py", "wb_settings.py", "dashboard.html")


def log(msg, quiet=False):
    if not quiet:
        sys.stdout.write("[update] %s\n" % msg)
        sys.stdout.flush()
    try:
        subprocess.run(["logger", "-t", "workbuddy2api-update", msg], timeout=10)
    except Exception:
        pass


def uci_get(option, default=None):
    try:
        out = subprocess.run(["uci", "get", "workbuddy2api.main.%s" % option],
                             capture_output=True, text=True, timeout=10)
        value = out.stdout.strip()
        return value if out.returncode == 0 and value else default
    except Exception:
        return default


def read_version(app_dir):
    """从 wb_proxy.py 里读 server_version = "wb-proxy/X.Y.Z"。"""
    path = os.path.join(app_dir, "wb_proxy.py")
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                m = re.search(r'server_version\s*=\s*"wb-proxy/([0-9][0-9.]*)"', line)
                if m:
                    return m.group(1)
    except Exception:
        pass
    return None


def vtuple(text):
    try:
        return tuple(int(x) for x in str(text).lstrip("v").split("."))
    except Exception:
        return (0,)


def fetch_latest_tag():
    """GitHub releases/latest -> 原始 tag（例如 v1.6.14）。

    注意：codeload 下载要用**带 v 前缀的原始 tag**，版本比较才用去掉前缀的
    （server_version 里是 1.6.14）。网络/限流错误抛异常。
    """
    req = urllib.request.Request(API_URL, headers=UA)
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.load(resp)
    tag = str(data.get("tag_name") or "").strip()
    if not tag:
        raise RuntimeError("GitHub 返回里没有 tag_name")
    return tag


def norm_ver(tag):
    return str(tag).strip().lstrip("v")


def download_tarball(tag, dest):
    url = TARBALL_URL % tag
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=120) as resp, open(dest, "wb") as fh:
        shutil.copyfileobj(resp, fh, 64 * 1024)
    return os.path.getsize(dest)


def stage_files(tar_path, stage_dir):
    """从 tarball 里只取 wb_*.py + dashboard.html（与包定义一致）。"""
    import tarfile
    os.makedirs(stage_dir, exist_ok=True)
    with tarfile.open(tar_path, "r:gz") as tf:
        members = []
        for m in tf.getmembers():
            if not m.isfile():
                continue
            name = os.path.basename(m.name)
            if name == "dashboard.html" or (name.startswith("wb_") and name.endswith(".py")):
                members.append((m, name))
        for m, name in members:
            with tf.extractfile(m) as src, open(os.path.join(stage_dir, name), "wb") as dst:
                shutil.copyfileobj(src, dst)
    return sorted(n for _, n in members)


def verify_stage(stage_dir, expected_ver):
    """返回 (ok, 说明)。四道校验：文件齐全 / 版本号 / 语法 / 真导入。"""
    for name in REQUIRED:
        path = os.path.join(stage_dir, name)
        if not os.path.isfile(path) or os.path.getsize(path) == 0:
            return False, "缺少文件或为空: %s" % name
    py_files = sorted(f for f in os.listdir(stage_dir) if f.startswith("wb_") and f.endswith(".py"))
    if len(py_files) < 8:
        return False, "wb_*.py 只有 %d 个，可疑" % len(py_files)

    got = read_version(stage_dir)
    if got != expected_ver:
        return False, "版本号不符: 包里是 %s，期望 %s" % (got, expected_ver)

    for name in py_files:
        try:
            py_compile.compile(os.path.join(stage_dir, name), doraise=True)
        except py_compile.PyCompileError as exc:
            return False, "语法检查失败 %s: %s" % (name, exc)

    # 真导入一次：能抓住「新版本用了当前 python3 没装的模块」这类问题。
    # 注意 server_version 是 handler 类的属性不是模块级属性，这里只验导入本身
    # （版本号上面已经按文件内容校验过）。
    mods = ", ".join(name[:-3] for name in py_files)
    code = ("import sys; sys.path.insert(0, %r); import %s; print('import-ok')"
            % (stage_dir, mods))
    try:
        out = subprocess.run([sys.executable, "-c", code], capture_output=True,
                             text=True, timeout=120, cwd=tempfile.gettempdir())
    except subprocess.TimeoutExpired:
        return False, "导入冒烟测试超时"
    if out.returncode != 0:
        tail = (out.stderr or "").strip().splitlines()[-3:]
        return False, "导入冒烟测试失败: %s" % " | ".join(tail)
    if "import-ok" not in out.stdout:
        return False, "导入冒烟测试没有输出预期结果"
    # 导入会在 stage 里生成 __pycache__，清掉：它是本次测试的副产物，
    # 不该被拷进 app 目录（_copy_tree 里也有一道同样的保险）。
    shutil.rmtree(os.path.join(stage_dir, "__pycache__"), ignore_errors=True)
    return True, "校验通过（%d 个 py，导入正常）" % len(py_files)


# ---------------------------------------------------------------- 文件替换

def _clear_dir(path):
    """清空目录内容：文件、符号链接、子目录都处理（这是上一版踩坑的地方）。"""
    if not os.path.isdir(path):
        return
    for name in os.listdir(path):
        target = os.path.join(path, name)
        if os.path.islink(target) or os.path.isfile(target):
            os.remove(target)
        elif os.path.isdir(target):
            shutil.rmtree(target)
        else:
            os.remove(target)


def _copy_tree(src_dir, dst_dir):
    """把 src_dir 的内容拷进 dst_dir（自动建目录、逐项处理子目录）。

    __pycache__ 一律跳过：字节码缓存是可再生的，且导入冒烟测试会在 stage 里
    生成一份，不该跟着换进 app 目录。
    """
    os.makedirs(dst_dir, exist_ok=True)
    for name in sorted(os.listdir(src_dir)):
        if name == "__pycache__":
            continue
        src = os.path.join(src_dir, name)
        dst = os.path.join(dst_dir, name)
        if os.path.isdir(src) and not os.path.islink(src):
            if os.path.isdir(dst):
                shutil.rmtree(dst)
            elif os.path.exists(dst):
                os.remove(dst)
            shutil.copytree(src, dst)
        else:
            if os.path.isdir(dst):
                shutil.rmtree(dst)
            shutil.copyfile(src, dst)
            os.chmod(dst, 0o644)


def install_stage(stage_dir):
    """备份当前版本到 PREV_DIR（不含 __pycache__），再把新文件换进 APP_DIR。"""
    if os.path.isdir(PREV_DIR):
        shutil.rmtree(PREV_DIR)
    if os.path.isdir(APP_DIR):
        shutil.copytree(APP_DIR, PREV_DIR,
                        ignore=shutil.ignore_patterns("__pycache__"))
        _clear_dir(APP_DIR)
    else:
        os.makedirs(APP_DIR, exist_ok=True)
    _copy_tree(stage_dir, APP_DIR)
    return True


def rollback(port, quiet):
    if not os.path.isdir(PREV_DIR) or not os.listdir(PREV_DIR):
        log("回滚失败：没有上一版备份 %s" % PREV_DIR, quiet)
        return False
    log("正在回滚到上一版...", quiet)
    _clear_dir(APP_DIR)
    _copy_tree(PREV_DIR, APP_DIR)
    restart_service()
    ok = health_check(port, 30)
    log("回滚%s（当前版本 %s）" % ("成功" if ok else "后健康检查仍失败，请人工检查",
                                  read_version(APP_DIR) or "?"), quiet)
    return ok


# ---------------------------------------------------------------- 服务与健康

def service_running():
    try:
        out = subprocess.run(["pgrep", "-f", SERVICE_PGREP], capture_output=True,
                             text=True, timeout=10)
        return out.returncode == 0 and bool(out.stdout.strip())
    except Exception:
        return False


def stop_service():
    subprocess.run([SERVICE, "stop"], capture_output=True, text=True, timeout=120)


def start_service():
    subprocess.run([SERVICE, "start"], capture_output=True, text=True, timeout=120)


def restart_service():
    subprocess.run([SERVICE, "restart"], capture_output=True, text=True, timeout=120)


def health_url(port):
    return HEALTH_URL_OVERRIDE or ("http://127.0.0.1:%s/health" % port)


def health_check(port, timeout=30):
    url = health_url(port)
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=5) as resp:
                if resp.status == 200:
                    return True
        except Exception:
            pass
        time.sleep(2)
    return False


def write_state(record):
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w", encoding="utf-8") as fh:
            json.dump(record, fh, ensure_ascii=False, indent=2)
    except Exception as exc:
        log("状态文件写入失败: %s" % exc, True)


def acquire_lock():
    """O_EXCL 锁；进程已不在则接管（避免上次异常退出把锁卡死）。"""
    try:
        fd = os.open(LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.write(fd, str(os.getpid()).encode())
        return fd
    except FileExistsError:
        try:
            pid = int(open(LOCK_FILE).read().strip() or 0)
        except Exception:
            pid = 0
        if pid and os.path.isdir("/proc/%d" % pid):
            return None
        try:
            os.remove(LOCK_FILE)
            fd = os.open(LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            os.write(fd, str(os.getpid()).encode())
            return fd
        except Exception:
            return None


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--check", action="store_true", help="只检查，有更新退出码 10")
    ap.add_argument("--force", action="store_true", help="无视版本比较，重装最新版")
    ap.add_argument("--rollback", action="store_true", help="回滚到上一版（不联网）")
    ap.add_argument("--quiet", action="store_true", help="只写 syslog，不打印")
    args = ap.parse_args()
    quiet = args.quiet

    port = uci_get("port", "8788")

    if args.rollback:
        return 0 if rollback(port, quiet) else 1

    if not args.force and uci_get("auto_update", "1") == "0":
        log("自动更新已在 uci 里关闭（workbuddy2api.main.auto_update=0），跳过", quiet)
        return 0

    lock = acquire_lock()
    if lock is None:
        log("已有另一个更新进程在跑，跳过", quiet)
        return 0
    try:
        installed = read_version(APP_DIR)
        if installed is None:
            log("找不到已安装版本（%s/wb_proxy.py 缺失？），跳过" % APP_DIR, quiet)
            return 1
        log("已安装 %s，查询上游最新版..." % installed, quiet)

        try:
            raw_tag = fetch_latest_tag()
        except Exception as exc:
            log("查询 GitHub 失败（网络/限流？）：%s —— 本次跳过，下次再试" % exc, quiet)
            return 0
        latest = norm_ver(raw_tag)
        log("上游最新版 %s（tag %s）" % (latest, raw_tag), quiet)

        if not args.force and vtuple(latest) <= vtuple(installed):
            log("已是最新（%s），无需更新" % installed, quiet)
            write_state({"installed_version": installed, "latest_seen": latest,
                         "checked_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                         "result": "up_to_date"})
            return 0

        if args.check:
            log("有新版本可更新：%s -> %s" % (installed, latest), quiet)
            return 10

        work = tempfile.mkdtemp(prefix="wb2api-update-")
        installed_ok = False
        was_running = False
        try:
            tar_path = os.path.join(work, "src.tar.gz")
            size = download_tarball(raw_tag, tar_path)
            log("已下载源码包 %.0f KB" % (size / 1024.0), quiet)

            stage = os.path.join(work, "stage")
            files = stage_files(tar_path, stage)
            log("暂存 %d 个文件" % len(files), quiet)

            ok, why = verify_stage(stage, latest)
            if not ok:
                log("校验失败：%s —— 放弃本次更新（不动现网）" % why, quiet)
                write_state({"installed_version": installed, "target": latest,
                             "checked_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                             "result": "verify_failed", "detail": why})
                return 1
            log(why, quiet)

            # 先停服务再换文件：避免运行中的进程写 __pycache__ / 半新半旧地跑
            was_running = service_running()
            if was_running:
                stop_service()
            install_stage(stage)
            installed_ok = True
            log("已替换 %s（上一版备份在 %s）" % (APP_DIR, PREV_DIR), quiet)

            if was_running:
                start_service()
                if health_check(port, 30):
                    log("更新成功：%s -> %s，服务健康" % (installed, latest), quiet)
                    write_state({"installed_version": latest, "previous_version": installed,
                                 "updated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                                 "result": "updated"})
                    return 0
                log("健康检查失败！自动回滚...", quiet)
                rollback(port, quiet)
                write_state({"installed_version": read_version(APP_DIR) or installed,
                             "failed_version": latest,
                             "updated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                             "result": "rolled_back"})
                return 1
            else:
                log("服务当前未运行，只更新了文件（下次启动即为 %s）" % latest, quiet)
                write_state({"installed_version": latest, "previous_version": installed,
                             "updated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                             "result": "updated_service_stopped"})
                return 0
        except Exception as exc:
            log("更新过程出错：%r" % (exc,), quiet)
            if installed_ok:
                log("文件已替换但后续步骤失败，尝试回滚...", quiet)
                rollback(port, quiet)
            else:
                # 出错时可能已经动过 APP_DIR（例如备份成功但清空后中断），
                # 备份还在就恢复，确保不会留下半残状态
                if os.path.isdir(PREV_DIR) and os.listdir(PREV_DIR):
                    log("现网文件可能不完整，从备份恢复...", quiet)
                    rollback(port, quiet)
                else:
                    log("现网文件未改动", quiet)
            return 1
        finally:
            shutil.rmtree(work, ignore_errors=True)
    finally:
        try:
            os.close(lock)
            os.remove(LOCK_FILE)
        except Exception:
            pass


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
