# WorkBuddy2API-Hub · OpenWrt 版 配置
#
# 改完执行：uci commit workbuddy2api && /etc/init.d/workbuddy2api restart
# 本文件含面板密码（可能还有固定 API Key），权限保持 600。

config workbuddy2api 'main'
	option host '0.0.0.0'
	option port '8788'

	# 数据目录：账号凭据（含 OAuth token，敏感）与用量日志
	option accounts_dir '/etc/workbuddy2api/accounts'
	option usage_dir '/etc/workbuddy2api/usage'

	# 面板登录密码。留空 = 保持现状（首次安装后默认是 admin，务必尽快设置）。
	# 这里一旦填了值，每次启动都会按它设置（面板里改的密码会在重启后回到这个值）；
	# 想长期用面板里改的密码，就把本项留空/注释掉。
	# option panel_password ''

	# 固定 API Key（客户端 Bearer token）。留空 = 由面板生成一个并持久化到
	# accounts/settings.json（可在面板「设置」里查看/复制），重启不丢。
	# 填了值则以此为准，适合多台客户端统一配置。
	# option api_key 'wb-xxxxxxxx'

	# 自动更新：1 = 每天由 cron 检查上游 GitHub 新版本并自动替换程序文件
	# （带校验与失败回滚，见 /usr/bin/workbuddy2api-update --help）。
	# 0 = 关闭自动更新（仍可手动跑 workbuddy2api-update）。
	option auto_update '1'

	# 整包自动更新：1 = 每天 13:30 检查自己的 fork（下面 pkg_repo）的 wrt-* release，
	# 有新版就用 apk 安装——服务脚本、默认配置、更新器/预热器本身只有这条链路会更新。
	# 带 sha256 校验、防降级护栏（包内应用版本低于当前应用文件时不装）、装前备好
	# 回滚包、健康检查与失败自动回滚（见 /usr/bin/workbuddy2api-pkgupdate --help）。
	option pkg_auto_update '1'

	# 取包的仓库（fork 的 owner/repo；包发布在 wrt-<应用版本>-<修订> 标签下）
	option pkg_repo 'aodianjun/workbuddy2api-hub'

	# 1 = apk add 时加 --allow-untrusted。CI 构建的包未签名，必须为 1；
	# 若哪天改成用自己信任的密钥签名（并把公钥装进 /etc/apk/keys/），可改 0。
	option pkg_allow_untrusted '1'

	# 统计缓存 TTL（秒，默认 1800=30 分钟）。面板每 5 秒轮询一次，而每次缓存
	# 过期都要全量重扫 usage.jsonl——在这台路由器上 2 万行约 12 秒。应用默认
	# 15 秒会让进程一直忙于重建（面板卡顿的根因）。
	#
	# 取值要和下面的预热频率配套：**缓存命中不会延长 TTL**，条目从「上次重建」
	# 起算过期，所以「已过期但还没被预热重建」的那段时间里，用户点开面板就得
	# 等一次全表扫描。TTL 900 + 预热 12 分钟 → 这个窗口约占 44%（实测经常撞上）；
	# TTL 1800 + 预热 2 分钟 → 降到 ~6%。调小 = 数字更实时但更吃 CPU；用了
	# 「每日限额」的话别调太大（限额计数也吃这份缓存）。
	option stats_ttl '1800'

	# 面板缓存预热器（workbuddy2api-warm，cron 每 2 分钟跑一遍）：
	# 提前把统计页 4 个时间窗、走势图 4 个时间窗、/usage 汇总、以及面板自己
	# 轮询的 realm 接口（intl/cn）重算好，用户切页不用等。全部命中时一轮只有
	# 毫秒级成本；只有真的重建过（慢）或失败才写 syslog。
	# 0 = 关闭（面板仍可用，只是缓存过期后第一次打开要等十几秒）。
	option warm '1'
